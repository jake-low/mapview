{
  "scripts": {
    "build": "esbuild src/app.tsx --bundle --minify --sourcemap --outfile=dist/bundle.js && esbuild node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --minify --format=esm --outfile=dist/maplibre-gl-worker.js && esbuild style.css --bundle --minify --outfile=dist/style.css",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true --write",
    "check": "tsc && biome check"
  },
  "dependencies": {
    "@b9g/crank": "^0.7.9",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.3.5",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.4.1",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/geojson": "^7946.0.16",
    "@types/shapefile": "^0.6.4",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
